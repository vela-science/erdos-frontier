{"assertion":{"kind":"theoretical","text":"Erdős Problem #138: declared status 'open'. Formalized: yes. Let the van der Waerden number $W(k)$ be such that whenever $N\\geq W(k)$ and $\\{1,\\ldots,N\\}$ is $2$-coloured there must exist a monochromatic $k$-term arithmetic progression. Improve the bounds for $W(k)$ - for example, prove that $W(k)^{1/k}\\to \\infty$. Current best: Gowers \\cite{Go01} has proved\\[W(k) \\leq 2^{2^{2^{2^{2^{k+9}}}}}.\\]The best general lower bound is $W(k)\\gg 2^k$, due to Kozik and Shabanov \\cite{KoSh16}. Prize: $500. OEIS: A005346. Tags: additive combinatorics."},"claim_id":"vcl_82defc99ca494f22909307d1e393d9837a5a48298f5c42709e707d889293e822","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:138","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_f28f35d12ed813e1","object_root":"sha256:5f918ebd996f6b046ecaf7ac9f2f5fb4014427e63981eaa2868790c1f54ee571","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:138"}],"relations":[],"revision":1,"sche