{"assertion":{"kind":"theoretical","text":"Erdős Problem #724: declared status 'open'. Formalized: no. Let $f(n)$ be the maximum number of mutually orthogonal Latin squares of order $n$. Is it true that\\[f(n) \\gg n^{1/2}?\\] Current best: Euler conjectured that $f(n)=1$ when $n\\equiv 2\\pmod{4}$, but this was disproved by Bose, Parker, and Shrikhande \\cite{BPS60} who proved $f(n)\\geq 2$ for $n\\geq 7$. Prize: no. OEIS: A001438. Tags: combinatorics."},"claim_id":"vcl_ea50db90831cd6e3aaf8e81c022070ad1758b622382a55cf7e795edc11dc8cc6","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:724","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_5af8f0923851a57f","object_root":"sha256:f08331eb04adf12ced453eb7abcf7380bec06d5dd8d7b1be8d3b5abcebd60275","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:724"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}