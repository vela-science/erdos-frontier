{"assertion":{"kind":"theoretical","text":"Erdős Problem #369: declared status 'proved'. Formalized: no. Let $\\epsilon>0$ and $k\\geq 2$. Is it true that, for all sufficiently large $n$, there is a sequence of $k$ consecutive integers in $\\{1,\\ldots,n\\}$ all of which are $n^\\epsilon$-smooth? Current best: If this is the problem then the answer is yes, which follows from a result of Balog and Wooley \\cite{BaWo98}: for any $\\epsilon>0$ and $k\\geq 2$ there exist infinitely many $m$ such that $m+1,\\ldots,m+k$ are all $m^\\epsilon$-smooth.{/LI} {LI}Each $m\\in P$ must be in $[n/2,n]$ (say). Prize: no. Tags: number theory."},"claim_id":"vcl_58aad215ade897e526fe7e1cd38bf6e3555bf218f7fdc30254fe31428067c10a","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:369","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_91a8c743266672d4","object_root":"sha256:0d85e7d2d799cd313414c8166939197ceba4f0c13b49a1a603a5e8dc714d6652","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:369"}