{"assertion":{"kind":"theoretical","text":"Erdős Problem #939: declared status 'open'. Formalized: yes. Let $r\\geq 2$. An $r$-powerful number $n$ is one such that if $p\\mid n$ then $p^r\\mid n$.\n\nIf $r\\geq 4$ then can the sum of $r-2$ coprime $r$-powerful numbers ever be itself $r$-powerful? Are there at most finitely many such solutions?\n\nAre there infinitely many triples of coprime $3$-powerful numbers $a,b,c$ such that $a+b=c$? Prize: no. Tags: number theory."},"claim_id":"vcl_0c87baed6478f9a021c707c96359e1beaae2038b9d85ae48a60d9ddba37fce29","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:939","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_6b6fa66eccd5a5aa","object_root":"sha256:2eae3ce65a7db1214f7ae15b64c2b857b2ae7c88d2dca3155cf2705a91a35b5c","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:939"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}