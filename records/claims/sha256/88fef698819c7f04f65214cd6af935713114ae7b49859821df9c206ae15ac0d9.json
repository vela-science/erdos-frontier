{"assertion":{"kind":"theoretical","text":"Erdős Problem #1104: declared status 'open'. Formalized: yes. Let $f(n)$ be the maximum possible chromatic number of a triangle-free graph on $n$ vertices. Estimate $f(n)$. Current best: The best bounds available are\\[(1-o(1))(n/\\log n)^{1/2}\\leq f(n) \\leq (2+o(1))(n/\\log n)^{1/2}.\\]The upper bound is due to Davies and Illingworth \\cite{DaIl22}, the lower bound follows from a construction of Hefty, Horn, King, and Pfender \\cite{HHKP25}. Prize: no. OEIS: A292528. Tags: chromatic number, graph theory."},"claim_id":"vcl_702472dcba0af52d905159bd352f8893ea2c48d6395b55d769b4ea68e7fd7a4a","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:1104","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_39be5d9f18afa96a","object_root":"sha256:efe20e8bd113a7b3225b6fa2baf5e843ebf318f305efa6d9c95b62023d60064a","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:1104"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}