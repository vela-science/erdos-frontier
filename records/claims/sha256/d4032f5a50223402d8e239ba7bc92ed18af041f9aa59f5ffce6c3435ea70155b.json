{"assertion":{"kind":"theoretical","text":"Erdős Problem #257: declared status 'open'. Formalized: yes. Let $A\\subseteq \\mathbb{N}$ be an infinite set. Is\\[\\sum_{n\\in A}\\frac{1}{2^n-1}\\]irrational? Current best: There is nothing special about $2$ here, and this sum is likely irrational with $2$ replaced by any integer $t\\geq 2$. This was disproved by Kova\\v{c} and Tao \\cite{KoTa24}, and in the comments Kova\\v{c} has sketched a proof that there exists some choice of $t_n$ with $1\\leq t_n\\leq 6$ such that this sum is rational. Prize: no. Tags: irrationality."},"claim_id":"vcl_cc158e44046a369076dd6d1bfe3dfcbadba0c4346e5224dc8962ff3d5dca10a4","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:257","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_c012e9b8b1780dcd","object_root":"sha256:a77b6af08ab68e7c03cf549125a5ac969e38e0f0bb841060e155930bfee3ec80","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:257"}],"relations":[],"revision":1,"schema":"vela.claim-record.