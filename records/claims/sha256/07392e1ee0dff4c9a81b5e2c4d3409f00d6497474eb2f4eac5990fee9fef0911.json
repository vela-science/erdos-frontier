{"assertion":{"kind":"theoretical","text":"Erdős Problem #475 [status: decidable; formalized: no]. Let $p$ be a prime. Given any finite set $A\\subseteq \\mathbb{F}_p\\backslash \\{0\\}$, is there always a rearrangement $A=\\{a_1,\\ldots,a_t\\}$ such that all partial sums $\\sum_{1\\leq k\\leq m}a_{k}$ are distinct, for all $1\\leq m\\leq t$? Current best: This has been proved for $t\\leq 12$ (see Costa and Pellegrini \\cite{CoPe20} and the references therein) and for $p-3\\leq t\\leq p-1$ (see Hicks, Ollis, and Schmitt \\cite{HOS19} and the references therein). Prize: no. Tags: additive combinatorics, number theory."},"claim_id":"vcl_5bc6b041a9bf3ae592cb381291007ecd22bd8ab7be00228feb0ff0279838c403","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:475","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_caec125014c711d0","object_root":"sha256:3e0bd39dd23730d38e5a1e9d32790812be5c52dc1c44c2c2983fe4389b67d872","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:475"}],"relati