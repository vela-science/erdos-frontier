{"assertion":{"kind":"theoretical","text":"Erdős Problem #734: declared status 'open'. Formalized: no. Find, for all large $n$, a non-trivial pairwise balanced block design $A_1,\\ldots,A_m\\subseteq \\{1,\\ldots,n\\}$ such that, for all $t$, there are $O(n^{1/2})$ many $i$ such that $\\lvert A_i\\rvert=t$. Current best: Erd\\H{o}s and de Bruijn \\cite{dBEr48} proved that if $A_1,\\ldots,A_m\\subseteq \\{1,\\ldots,n\\}$ is a pairwise balanced block design then $m\\geq n$, and this implies there must be some $t$ such that there are $\\gg n^{1/2}$ many $t$ with $\\lvert A_i\\rvert=t$. Prize: no. Tags: combinatorics."},"claim_id":"vcl_a3fc55a90b20c6c3a9aeaa64518ab4600906f482e2bbb0ea0e240e2e7962444f","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:734","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_2118f355df15285e","object_root":"sha256:8d7d3f26fc70e68781d49c1e526a74b70c6f15c35b3c7f8c8d7f5007df7d33f1","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:734"}],"relations