{"assertion":{"kind":"theoretical","text":"Erdős Problem #162: declared status 'open'. Formalized: no. Let $\\alpha>0$ and $n\\geq 1$. Let $F(n,\\alpha)$ be the largest $k$ such that there exists some 2-colouring of the edges of $K_n$ in which any induced subgraph $H$ on at least $k$ vertices contains more than $\\alpha\\binom{\\lvert H\\rvert}{2}$ many edges of each colour.\n\nProve that for every fixed $0\\leq \\alpha \\leq 1/2$, as $n\\to\\infty$,\\[F(n,\\alpha)\\sim c_\\alpha \\log n\\]for some constant $c_\\alpha$. Prize: no. Tags: combinatorics, discrepancy, ramsey theory."},"claim_id":"vcl_6e68a3b9867736b204d8ffb20986af94ea27eeeaef76ad5fb8511e4cd8828f86","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:162","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_bb476594ca68234c","object_root":"sha256:bbe123a27f60fd35f161c973217e45c8acfdc48612a58d2ee15c9e34ec3474ec","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:162"}],"relations":[],"revision":1,"schema":"vela.cla