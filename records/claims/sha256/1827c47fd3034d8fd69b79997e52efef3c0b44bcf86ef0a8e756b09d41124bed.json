{"assertion":{"kind":"theoretical","text":"Erdős Problem #679: declared status 'open'. Formalized: no. Let $\\epsilon>0$ and $\\omega(n)$ count the number of distinct prime factors of $n$. Are there infinitely many values of $n$ such that\\[\\omega(n-k) < (1+\\epsilon)\\frac{\\log k}{\\log\\log k}\\]for all $k<n$ which are sufficiently large depending on $\\epsilon$ only?\n\nCan one show the stronger version with\\[\\omega(n-k) < \\frac{\\log k}{\\log\\log k}+O(1)\\]is false? Prize: no. Tags: number theory."},"claim_id":"vcl_febe6d8c4775345d26a536c861c70df0ad1beb309555a808796de5addf16cc2e","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:679","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_2ea2fdedfea8ffb7","object_root":"sha256:faa9d4ad2dbd912d9c3889c9ce358ec9ee2f960b6ac5d5b86358fd4e8988f08c","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:679"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}