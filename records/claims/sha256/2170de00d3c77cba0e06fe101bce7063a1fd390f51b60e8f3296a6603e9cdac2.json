{"assertion":{"kind":"theoretical","text":"Erdős Problem #969: declared status 'open'. Formalized: no. Let $Q(x)$ count the number of squarefree integers in $[1,x]$. Determine the order of magnitude in the error term in the asymptotic\\[Q(x)=\\frac{6}{\\pi^2}x+E(x).\\] Current best: The best known unconditional upper bound is of the shape $x^{1/2-o(1)}$, due to Walfisz \\cite{Wa63}. Conditional on this assumption, the best known upper bound is\\[E(x)\\ll x^{\\frac{11}{35}+o(1)},\\]due to Liu \\cite{Li16}. Prize: no. OEIS: A013928. Tags: number theory."},"claim_id":"vcl_cf03ae7ed34d982c5b53761fbbcc6dc84bfedc20c430229256e175674e3b4b61","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:969","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_aaa7ab75d8ce450f","object_root":"sha256:e1b638f688ff835a8fddb9b89afae29d1127e08c1a1e8a5c9f6458acde0325a6","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:969"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}