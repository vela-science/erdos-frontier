{"assertion":{"kind":"theoretical","text":"Erdős Problem #252: declared status 'open'. Formalized: yes. Let $k\\geq 1$ and $\\sigma_k(n)=\\sum_{d\\mid n}d^k$. Is\\[\\sum \\frac{\\sigma_k(n)}{n!}\\]irrational? Current best: This is known now for $1\\leq k\\leq 4$. It is known that this sum is irrational for all $k\\geq 1$ conditional on either Schinzel's conjecture (Schlage-Puchta \\cite{ScPu06}) or the prime tuples conjecture (Friedlander, Luca, and Stoiciu \\cite{FLC07}). Prize: no. OEIS: A227988, A227989. Tags: irrationality, number theory."},"claim_id":"vcl_055d5bec43e3bca0d815a39c116e0b1be8cf4309c12507fab1c5f75941fdf947","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:252","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_03c2b87702300880","object_root":"sha256:9beea1e81d5f2a3a0d713cb11b0f0aae0515caabd953e22e141bae3d7b3f965c","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:252"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}