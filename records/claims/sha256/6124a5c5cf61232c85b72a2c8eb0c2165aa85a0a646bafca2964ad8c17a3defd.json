{"assertion":{"kind":"theoretical","text":"Erdős Problem #287 [status: falsifiable; formalized: no]. Let $k\\geq 2$. Is it true that, for any distinct integers $1<n_1<\\cdots <n_k$ such that\\[1=\\frac{1}{n_1}+\\cdots+\\frac{1}{n_k}\\]we must have $\\max(n_{i+1}-n_i)\\geq 3$? Current best: The lower bound of $\\geq 2$ is equivalent to saying that $1$ is not the sum of reciprocals of consecutive integers, proved by Erd\\H{o}s \\cite{Er32}. Prize: no. Tags: number theory, unit fractions."},"claim_id":"vcl_fc540a8f9c236cdfecb37cc921438eafb16cfe0f510e587b4fe63e9c02bc0546","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:287","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_407f91b10bfd15b3","object_root":"sha256:f6e754362e518b7642a1bcf06cb0856922211a4a736ee86cba457af98da6c769","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:287"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}