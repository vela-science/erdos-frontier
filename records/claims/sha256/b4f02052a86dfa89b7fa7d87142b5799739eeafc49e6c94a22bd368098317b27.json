{"assertion":{"kind":"theoretical","text":"Erdős Problem #340: declared status 'open'. Formalized: yes. Let $A=\\{1,2,4,8,13,21,31,45,66,81,97,\\ldots\\}$ be the greedy Sidon sequence: we begin with $1$ and iteratively include the next smallest integer that preserves the Sidon property (i.e. there are no non-trivial solutions to $a+b=c+d$). What is the order of growth of $A$? Is it true that\\[\\lvert A\\cap \\{1,\\ldots,N\\}\\rvert \\gg N^{1/2-\\epsilon}\\]for all $\\epsilon>0$ and large $N$? Prize: no. OEIS: A005282, A080200. Tags: additive combinatorics, number theory, sidon sets."},"claim_id":"vcl_62b61e37c53f3f038d04e661b5d3de46bf04b97b2763169e42a55dbe956f811a","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:340","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_ef030ab1e4bd5d53","object_root":"sha256:dde81dbe21a20e8862f921f85ba8b72eba64edee6814e6d817782eb7bb4e36c9","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:340"}],"relations":[],"revision":1,"schema":"vel