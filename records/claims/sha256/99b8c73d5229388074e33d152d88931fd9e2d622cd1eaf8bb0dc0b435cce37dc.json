{"assertion":{"kind":"theoretical","text":"Erdős Problem #334: declared status 'open'. Formalized: no. Find the best function $f(n)$ such that every $n$ can be written as $n=a+b$ where both $a,b$ are $f(n)$-smooth (that is, are not divisible by any prime $p>f(n)$.) Current best: This is known, and the best bound is due to Balog \\cite{Ba89} who proved that\\[f(n) \\ll_\\epsilon n^{\\frac{4}{9\\sqrt{e}}+\\epsilon}\\]for all $\\epsilon>0$. Prize: no. OEIS: A045535, A062241. Tags: number theory."},"claim_id":"vcl_7f3e9cf7978055f0b4ad2a16eaa9b0897e5388f9b016ece6ea3a4ce4a582b9a1","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:334","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_1b24133f14ee1871","object_root":"sha256:a0d4bfc64a587786086de2decee01d0814e127b0523382f50492aecef7211b16","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:334"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}