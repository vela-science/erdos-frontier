{"assertion":{"kind":"theoretical","text":"Erdős Problem #188: declared status 'open'. Formalized: yes. What is the smallest $k$ such that $\\mathbb{R}^2$ can be red/blue coloured with no pair of red points unit distance apart, and no $k$-term arithmetic progression of blue points with distance $1$? Current best: Erd\\H{o}s, Graham, Montgomery, Rothschild, Spencer, and Straus \\cite{EGMRSS75} proved $k\\geq 5$. Tsaturian \\cite{Ts17} improved this to $k\\geq 6$. Erd\\H{o}s and Graham claim that $k\\leq 10000000$ ('more or less'), but give no proof. Prize: no. Tags: geometry, ramsey theory."},"claim_id":"vcl_6d4dafb5a73e6852632a6d18821ca1d6ce78b70e15d1240ac55c1b4c9c2346bc","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:188","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_7e3907e2bfff176f","object_root":"sha256:ed26d4ab3206d8d0018dc207e1947b61bd26a15b02bcdcac47c1f21713cd0709","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:188"}],"relations":[],"revision":1,"schema