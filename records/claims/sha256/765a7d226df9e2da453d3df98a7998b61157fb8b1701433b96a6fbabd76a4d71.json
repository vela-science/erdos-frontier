{"assertion":{"kind":"theoretical","text":"Erdős Problem #1055: declared status 'open'. Formalized: yes. A prime $p$ is in class $1$ if the only prime divisors of $p+1$ are $2$ or $3$. In general, a prime $p$ is in class $r$ if every prime factor of $p+1$ is in some class $\\leq r-1$, with equality for at least one prime factor.\n\nAre there infinitely many primes in each class? If $p_r$ is the least prime in class $r$, then how does $p_r^{1/r}$ behave? Prize: no. OEIS: A005113. Tags: number theory, primes."},"claim_id":"vcl_0743e7bd93088029bf1f90771b305cd2f3a12e22ec3ae42fee2cc58db869c6aa","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:1055","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_7ca640a9b7b59415","object_root":"sha256:c6ff5e0974e34fdfb3e32ef9e193f4697a85e467bfee756bb451038d41e42644","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:1055"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}