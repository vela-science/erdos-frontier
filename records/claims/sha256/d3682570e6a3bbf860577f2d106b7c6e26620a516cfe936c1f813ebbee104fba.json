{"assertion":{"kind":"theoretical","text":"Erdős Problem #279: declared status 'open'. Formalized: yes. Let $k\\geq 3$. Is there a choice of congruence classes $a_p\\pmod{p}$ for every prime $p$ such that all except finitely many integers can be written as $a_p+tp$ for some prime $p$ and integer $t\\geq k$? Current best: This may be true with the primes replaced by any set $A\\subseteq \\mathbb{N}$ such that\\[\\lvert A\\cap [1,N]\\rvert \\gg N/\\log N\\]and\\[\\sum_{\\substack{n\\in A\\\\ n\\leq N}}\\frac{1}{n} -\\log\\log N\\to \\infty\\]as $N\\to \\infty$. Prize: no. Tags: covering systems, number theory, primes."},"claim_id":"vcl_5cba4385c19b50a34bf2fca0df430ce52ff9c9af00f25de5ee58b170572c3f1e","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:279","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_f407aedc44112351","object_root":"sha256:238c9a8add0822d49cb925ecbb4d63d641f276573754084c91b4de1718fcd793","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:279"}],"relatio