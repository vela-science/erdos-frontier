{"assertion":{"kind":"theoretical","text":"Erdős Problem #325: declared status 'open'. Formalized: yes. Let $k\\geq 3$ and $f_{k,3}(x)$ denote the number of integers $\\leq x$ which are the sum of three nonnegative $k$th powers. Is it true that\\[f_{k,3}(x) \\gg x^{3/k}\\]or even $\\gg_\\epsilon x^{3/k-\\epsilon}$? Current best: For $k=3$ the best known is due to Wooley \\cite{Wo15},\\[f_{3,3}(x) \\gg x^{0.917\\cdots}.\\]This problem has been formalised in Lean as part of the Google DeepMind Formal Conjectures project. Prize: no. Tags: number theory, powers."},"claim_id":"vcl_6628558270bf0f8920b5d75ddce1b249da6fdba56241f9c3cd9782e98b2d57ab","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:325","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_4b08b99a23120b16","object_root":"sha256:588abfd84b7ed978758c61c813099ba38b8fe2f7fb5e8aadc0a2bb6338c8464a","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:325"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}