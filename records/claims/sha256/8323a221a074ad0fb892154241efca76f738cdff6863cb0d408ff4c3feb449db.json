{"assertion":{"kind":"theoretical","text":"Erdős Problem #779 [status: falsifiable; formalized: yes]. Let $n> 1$ and $p_1<\\cdots<p_n$ denote the first $n$ primes. Let $P=\\prod_{1\\leq i\\leq n}p_i$. Does there always exist some prime $p$ with $p_n<p<P$ such that $P+p$ is prime? Current best: Erd\\H{o}s expects that the least such prime is much smaller than $P$, and in fact satisfies $p\\leq n^{O(1)}$. Deaconescu has verified this conjecture for $n\\leq 1000$. Prize: no. OEIS: A005235. Tags: number theory, primes."},"claim_id":"vcl_f8cffc7d22ad4120842e1766668bf87c9574c8a2804bde12f328aebc5b4e71eb","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:779","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_8b25636f8f40cb86","object_root":"sha256:79be70e80ac6503ff6cbde5d1f4e27278a484c64356afd5ca9a92864245414c3","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:779"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}