{"assertion":{"kind":"theoretical","text":"Erdős Problem #321: declared status 'open'. Formalized: yes. What is the size of the largest $A\\subseteq \\{1,\\ldots,N\\}$ such that all sums $\\sum_{n\\in S}\\frac{1}{n}$ are distinct for $S\\subseteq A$? Current best: Results of Bleicher and Erd\\H{o}s from \\cite{BlEr75} and \\cite{BlEr76b} imply that\\[\\frac{N}{\\log N}\\prod_{i=3}^k\\log_iN\\leq R(N)\\leq \\frac{1}{\\log 2}\\log_r N\\left(\\frac{N}{\\log N} \\prod_{i=3}^r \\log_iN\\right),\\]valid for any $k\\geq 4$ with $\\log_kN\\geq k$ and any $r\\geq 1$ with $\\log_{2r}N\\geq 1$. Prize: no. OEIS: A384927, A391592. Tags: number theory, unit fractions."},"claim_id":"vcl_02e5db4d2c6cb6eddfc2f632a47dc06518a4c020280b680d6bb732aa1825f99a","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:321","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_96a6e2e523949dc8","object_root":"sha256:011ec4d985922f8d4aee1c02abeba7633cb28b3cb23f3a30414ddb20ec9eea22","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_reco