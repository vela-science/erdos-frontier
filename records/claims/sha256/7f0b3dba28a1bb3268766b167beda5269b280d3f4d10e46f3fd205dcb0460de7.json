{"assertion":{"kind":"theoretical","text":"Erdős Problem #104: declared status 'open'. Formalized: no. Given $n$ points in $\\mathbb{R}^2$ the number of distinct unit circles containing at least three points is $o(n^2)$. Current best: Erd\\H{o}s claims in a number of places this produces the upper bound $n(n-1)$, but Harborth and Mengerson \\cite{HaMe86} note that in fact this delivers an upper bound of $\\frac{n(n-1)}{3}$. Prize: $100. OEIS: A003829. Tags: geometry."},"claim_id":"vcl_a7a290fdbd546093ec47f0d93303b87d6e6d080c36f0a0fca6e990a29728cf7c","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:104","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_6e0d860aebdb8f4b","object_root":"sha256:cfa06d15efad8da04c84c11d36f4233d1a50806526f39d3599bae72ac60ce3c9","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:104"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}