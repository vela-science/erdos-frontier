{"assertion":{"kind":"theoretical","text":"Erdős Problem #629: declared status 'open'. Formalized: no. The list chromatic number $\\chi_L(G)$ is defined to be the minimal $k$ such that for any assignment of a list of $k$ colours to each vertex of $G$ (perhaps different lists for different vertices) a colouring of each vertex by a colour on its list can be chosen such that adjacent vertices receive distinct colours.\n\nDetermine the minimal number of vertices $n(k)$ of a bipartite graph $G$ such that $\\chi_L(G)>k$. Prize: no. Tags: chromatic number, graph theory."},"claim_id":"vcl_7c7c4a6b03b820c9b7e93b90faf543534335e9d39a33745782c1a6bde9e28642","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:629","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_060fb056d1361da9","object_root":"sha256:f191869024490eb4ce9feeba94cd0cc35c1d1d98d971cce5a92a8125aa3848b2","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:629"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}