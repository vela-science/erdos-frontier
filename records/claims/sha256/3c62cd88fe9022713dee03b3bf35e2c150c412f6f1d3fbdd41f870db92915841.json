{"assertion":{"kind":"theoretical","text":"Erdős Problem #812: declared status 'open'. Formalized: yes. Is it true that\\[\\frac{R(n+1)}{R(n)}\\geq 1+c\\]for some constant $c>0$, for all large $n$? Is it true that\\[R(n+1)-R(n) \\gg n^2?\\] Current best: Burr, Erd\\H{o}s, Faudree, and Schelp \\cite{BEFS89} proved that\\[R(n+1)-R(n) \\geq 4n-8\\]for all $n\\geq 2$. The lower bound of [165] implies that\\[R(n+2)-R(n) \\gg n^{2-o(1)}.\\]  References  [BEFS89] Burr, S. Prize: no. OEIS: A059442. Tags: graph theory, ramsey theory."},"claim_id":"vcl_be012a2ee22ed98f56c5434d0e0b4d7dc19f6c90b4b8ec1c6bd17a02b5f83e55","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:812","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_813620a88b22ab3d","object_root":"sha256:cfbdebbc9037c27e381e08f07ab9f895ce047c44b99eef93bd44991fbee43a2e","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:812"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}