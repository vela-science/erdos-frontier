{"assertion":{"kind":"theoretical","text":"Erdős Problem #852: declared status 'open'. Formalized: no. Let $d_n=p_{n+1}-p_n$, where $p_n$ is the $n$th prime. Let $h(x)$ be maximal such that for some $n<x$ the numbers $d_n,d_{n+1},\\ldots,d_{n+h(x)-1}$ are all distinct. Estimate $h(x)$. In particular, is it true that\\[h(x) >(\\log x)^c\\]for some constant $c>0$, and\\[h(x)=o(\\log x)?\\] Prize: no. OEIS: A001223, A053597, A078515. Tags: number theory, primes."},"claim_id":"vcl_1ec5e11015afbeac3fd63918ae9a97031bd1e0f179304b9aa7cf515b5469b5d4","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:852","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_6bd0f9f59a819c92","object_root":"sha256:42a3365e441c0e40516d4bc23faedee6a1a5195bd8c134c24627de6af02f1bd8","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:852"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}