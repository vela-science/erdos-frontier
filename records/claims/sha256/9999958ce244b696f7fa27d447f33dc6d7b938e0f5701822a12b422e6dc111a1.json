{"assertion":{"kind":"theoretical","text":"Erdős Problem #222: declared status 'open'. Formalized: no. Let $n_1<n_2<\\cdots$ be the sequence of integers which are the sum of two squares. Explore the behaviour of (i.e. find good upper and lower bounds for) the consecutive differences $n_{k+1}-n_k$. Current best: The best known upper bound is due to Bambah and Chowla \\cite{BaCh47}, who proved that\\[n_{k+1}-n_k \\ll n_k^{1/4}.\\]The differences are listed at A256435 on the OEIS. Prize: no. OEIS: A256435. Tags: number theory, squares."},"claim_id":"vcl_1f0fb79caf1a697e1afca6b539c82664586446f215cf9d8a2ec757f0a09797e3","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:222","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_57c4d9aea8e1352d","object_root":"sha256:8591b4d48883f00f83b6efd2b5c81076358265144562e84937e29433581a8767","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:222"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}