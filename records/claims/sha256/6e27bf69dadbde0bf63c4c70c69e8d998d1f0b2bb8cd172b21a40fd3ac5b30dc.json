{"assertion":{"kind":"theoretical","text":"Erdős Problem #936: declared status 'open'. Formalized: yes. Are\\[2^n\\pm 1\\]and\\[n!\\pm 1\\]powerful (i.e. if $p\\mid m$ then $p^2\\mid m$) for only finitely many $n$? Current best: Cushing and Pascoe \\cite{CuPa16} have shown the answer to the second question is yes assuming the abc conjecture - in fact, for any fixed $k\\geq 0$, there are only finitely many $n$ and powerful $x$ such that $\\lvert x-n!\\rvert \\leq k$. Prize: no. OEIS: A146968. Tags: number theory."},"claim_id":"vcl_654d6a582535b5f3262a0302d1c93cd6dbc9433ec71dbb11cd5a4071320cff71","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:936","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_8b2226b16fab11c0","object_root":"sha256:29cf44f9b8de31c7095c38637d782765067fa8911bc12fd6abf840f0f0099cea","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:936"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}