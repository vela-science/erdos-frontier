{"assertion":{"kind":"theoretical","text":"Erdős Problem #825: declared status 'proved'. Formalized: yes. Is there an absolute constant $C>0$ such that every integer $n$ with $\\sigma(n)>Cn$ is the distinct sum of proper divisors of $n$? Current best: In other words, this problem asks for an upper bound for the abundancy index of weird numbers. A similar argument shows that either there are infinitely many primitive weird numbers or there is an upper bound for the abundancy index of all weird numbers. Prize: $25. OEIS: A006037, A330244. Tags: number theory."},"claim_id":"vcl_e101e21caa6e7a0f6b457149679750af56099d1c4389cc98defccdcae0c3668b","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:825","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_83effdcf6b21e8dc","object_root":"sha256:c6572beacc1bf2e835fb59d6e243923921306c576640209be03c5e29688773f9","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:825"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}