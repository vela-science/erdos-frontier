{"assertion":{"kind":"theoretical","text":"Erdős Problem #1004: declared status 'open'. Formalized: yes. Let $c>0$. If $x$ is sufficiently large then does there exist $n\\leq x$ such that the values of $\\phi(n+k)$ are all distinct for $1\\leq k\\leq (\\log x)^c$, where $\\phi$ is the Euler totient function? Current best: Erd\\H{o}s, Pomerenace, and S\\'{a}rk\\\"{o}zy \\cite{EPS87} proved that if $\\phi(n+k)$ are all distinct for $1\\leq k\\leq K$ then\\[K \\leq \\frac{n}{\\exp(c(\\log n)^{1/3})}\\]for some constant $c>0$. Prize: no. Tags: number theory."},"claim_id":"vcl_d39fae7ecc3476dbccce1920f65e0a008a5a7187420e58039ab4d0a189b22501","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:1004","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_da7c4cff9da083d7","object_root":"sha256:d72ab827a42e6216052ce0ff7289d487415df0ab737a9ab937871d450c972ca7","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:1004"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}