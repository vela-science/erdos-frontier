{"assertion":{"kind":"theoretical","text":"Erdős Problem #84: declared status 'open'. Formalized: no. The cycle set of a graph $G$ on $n$ vertices is a set $A\\subseteq \\{3,\\ldots,n\\}$ such that there is a cycle in $G$ of length $\\ell$ if and only if $\\ell \\in A$. Let $f(n)$ count the number of possible such $A$.\n\nProve that $f(n)=o(2^n)$.\n\nProve that $f(n)/2^{n/2}\\to \\infty$. Prize: no. Tags: cycles, graph theory."},"claim_id":"vcl_6907b7e7699c48b2336359ece25348dee516018a2dfe5a8d4e44a3577e75eb49","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:84","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_845babe19440a37f","object_root":"sha256:aec23f68d18db93391668082ff1c379b643f3a365a5389d6268a58d72eb5d384","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:84"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}