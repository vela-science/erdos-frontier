{"assertion":{"kind":"theoretical","text":"Erdős Problem #1095: declared status 'open'. Formalized: yes. Let $g(k)>k+1$ be the smallest $n$ such that all prime factors of $\\binom{n}{k}$ are $>k$. Estimate $g(k)$. Current best: In \\cite{EES74} they further conjecture that\\[\\limsup \\frac{g(k+1)}{g(k)}=\\infty\\]and\\[\\liminf \\frac{g(k+1)}{g(k)}=0.\\]The lower bound was improved by Erd\\H{o}s, Lacampagne, and Selfridge \\cite{ELS93} and Granville and Ramar\\'{e} \\cite{GrRa96}. The current record is\\[g(k) \\gg \\exp(c(\\log k)^2)\\]for some $c>0$, due to Konyagin \\cite{Ko99b}. Prize: no. OEIS: A003458. Tags: binomial coefficients, number theory."},"claim_id":"vcl_c73b1148a3e262a58f190ade8ba22164181c9b07b916eefccf35e9e089b09b17","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:1095","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_cf8d1fe4bb64bf4b","object_root":"sha256:e435db307f8becf0783561177d28ff0aa63b1035511ba5374931a3f3b1d1069e","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record