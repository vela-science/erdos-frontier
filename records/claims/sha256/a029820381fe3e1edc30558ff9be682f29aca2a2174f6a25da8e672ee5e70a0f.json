{"assertion":{"kind":"theoretical","text":"Erdős Problem #790: declared status 'open'. Formalized: no. Let $l(n)$ be maximal such that if $A\\subset\\mathbb{Z}$ with $\\lvert A\\rvert=n$ then there exists a sum-free $B\\subseteq A$ with $\\lvert B\\rvert \\geq l(n)$ - that is, $B$ is such that there are no solutions to\\[a_1=a_2+\\cdots+a_r\\]with $a_i\\in B$ all distinct.\n\nEstimate $l(n)$. In particular, is it true that $l(n)n^{-1/2}\\to \\infty$? Is it true that $l(n)< n^{1-c}$ for some $c>0$? Prize: no. Tags: additive combinatorics."},"claim_id":"vcl_ad4e4a199d21260066884b27f403a00586c4dbd237a3f04a1deabbe7358ba783","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:790","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_6bd900dc545702b1","object_root":"sha256:2096fbe5d93086a1a5e737bce943a7e12ae05ea6dd572dc678a0c44ea894a850","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:790"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}