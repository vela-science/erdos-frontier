{"assertion":{"kind":"theoretical","text":"Erdős Problem #112: declared status 'open'. Formalized: no. Let $k=k(n,m)$ be minimal such that any directed graph on $k$ vertices must contain either an independent set of size $n$ or a transitive tournament of size $m$. Determine $k(n,m)$. Current best: Zach Hunter has observed that\\[R(n,m) \\leq k(n,m)\\leq R(n,m,m),\\]which in particular proves the upper bound $k(n,m)\\leq 3^{n+2m}$. Prize: no. Tags: graph theory, ramsey theory."},"claim_id":"vcl_3350d63ddc1f3fe726eda1c770efb20e3cb5dc151816d1e9c5cb0ef1c82f760e","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:112","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_37098dcc5106fdc4","object_root":"sha256:7a719af231cca986a421a0367b2abd25921acb6f56e4db603ed56725cd62bfa1","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:112"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}