{"assertion":{"kind":"theoretical","text":"Erdős Problem #585: declared status 'open'. Formalized: no. What is the maximum number of edges that a graph on $n$ vertices can have if it does not contain two edge-disjoint cycles with the same vertex set? Current best: Indeed, they prove that there exists a constant $C>0$ such that for any $k\\geq 2$ there is a $c_k$ such that if a graph has $n$ vertices and at least $c_kn(\\log n)^{C}$ many edges then it contains $k$ pairwise edge-disjoint cycles with the same vertex set. Prize: no. Tags: cycles, graph theory."},"claim_id":"vcl_53ccaad4ab3f9696a7552f6e0bd859c5ab42cef59fed9a1e4939e6d5d25feb36","conditions":[],"created_at":"2026-06-16T00:00:00Z","evidence":[],"extensions":{"vela.legacy-finding.v1":{"annotations":[],"attachments":[],"confidence":{"basis":"external catalogue record","extraction_confidence":1.0,"kind":"frontier_epistemic","method":"llm_initial","score":0.5},"flags":{"contested":false,"declining":false,"gap":false,"gravity_well":false,"negative_space":false,"retracted":false},"legacy_conditions":{"duration":null,"text":""},"legacy_evidence":{"evidence_spans":[],"method":"erdos_deep","model_system":"n/a","replicated":false,"replication_count":null,"type":"theoretical"},"legacy_links":[],"legacy_provenance":{"authors":[],"doi":null,"extraction":{"extracted_at":"","extractor_version":"","method":"database_import","model":null,"model_version":null},"review":null,"source_type":"database_record","title":"erdos_deep:585","year":null},"previous_version":null,"source_schema":"https://vela.science/schema/finding-bundle/v0.10.0","source_version":1,"updated":null}},"imported_from":{"era":"finding_v0_10","object_id":"vf_39f036ba377a0caf","object_root":"sha256:99871106ca486dd090faef829160970720deb9ae460ffdf5b6852c4ee2d6aa58","predecessor_commit":"c236b4fdedb25e0d726e24e2780d50962e4844f7"},"provenance":[{"kind":"database_record","title":"erdos_deep:585"}],"relations":[],"revision":1,"schema":"vela.claim-record.v1"}